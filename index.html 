        // Firebase Setup
        const firebaseConfig = {
            apiKey: "AIzaSyBZVwNtZ3EOAAtSJ69delNpKSRRkCjF2ak",
            authDomain: "my-eshop-a5bd4.firebaseapp.com",
            projectId: "my-eshop-a5bd4",
