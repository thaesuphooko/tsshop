        </div>
    
    <script>
        // စမ်းသပ်ရန် - ပစ္စည်းတစ်ခုခုကို နှိပ်လိုက်ရင် Telegram ဆီချက်ချင်းရောက်ပါမယ်
        function purchase(item) {
            alert(item + " ကို ဝယ်ယူရန် ကြိုးစားနေသည်...");
            window.sendToTelegram("Purchase Attempt", { item: item });
        }
        
        // Product Listing Example
        const products = [{name: "Cologne", price: "50,000"}];
        document.getElementById('shop').innerHTML = products.map(p => `
            <div class="bg-white p-4 rounded border">
                <p class="font-bold">${p.name}</p>
                <button onclick="purchase('${p.name}')" class="bg-blue-600 text-white w-full py-2 mt-2">ဝယ်မည်</button>
            </div>
        `).join('');
    </script>
